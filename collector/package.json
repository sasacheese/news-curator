    "jsdom": "^30.1.3",
    "openai": "^7.39.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/web-push": "^3.6.4",
    "ai": "^7.0.143",
    "ai-sdk-provider-claude-code": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
