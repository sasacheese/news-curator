{
  "name": "news-curator",
  "private": true,
  "version": "1.0.0",
  "description": "関心のあるトピックの最新情報を毎朝30分でキャッチアップするAIキュレーションツール",
  "type": "module",
  "workspaces": [
    "collector",
    "web"
  ],
  "scripts": {
    "collect": "npm run -w collector start --",
    "collect:dry": "npm run -w collector start -- --dry-run",
    "dev": "npm run -w web dev",
    "build": "npm run -w web build",
    "preview": "npm run -w web preview",
    "typecheck": "npm run -w collector typecheck && npm run -w web typecheck",
    "compare": "npm run -w collector compare --",
    "check:llm": "npm run -w collector check:llm",
    "push:send": "npm run -w collector push:send",
    "push:keygen": "npm run -w collector push:keygen",
    "test": "npm run -w collector test",
    "radar:dry": "npm run -w collector radar:dry --"
  },
  "engines": {
    "node": ">=22"
  }
}
