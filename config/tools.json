{
  "$comment": "道具箱の入口（道具専用のソース）。enabled: false で止めます。いつもの収集（今日タブの記事・急上昇・Show HN・発掘）から拾う入口は常に有効です。",
  "mcpRegistry": {
    "$comment": "公式 MCP Registry。前回の実行以降に公開・更新されたサーバー。1 ページ 100 件",
    "enabled": true,
    "maxPages": 3,
    "$comment_maxItems": "1 日 200 件を超えるので、台帳に無いもの・リポジトリを公開しているものを優先して maxItems 件まで",
    "maxItems": 40
  },
  "claudeMarketplace": {
    "$comment": "Claude Code 公式プラグインのマーケットプレイス。日付を持たないので、台帳に無いものを 1 回 maxNewPerRun 件ずつ入れる",
    "enabled": true,
    "url": "https://raw.githubusercontent.com/anthropics/claude-plugins-official/main/.claude-plugin/marketplace.json",
    "maxNewPerRun": 15
  },
  "anthropicSkills": {
    "enabled": true,
    "repo": "anthropics/skills",
    "path": "skills",
    "maxNewPerRun": 5
  },
  "githubTopics": {
    "$comment": "topic を付けて新しく作られたリポジトリ。Search API は認証ありで 30 回/分",
    "enabled": true,
    "topics": ["claude-code", "claude-code-plugin", "claude-skills", "agent-skills", "mcp-server", "cursor-rules", "cursor-plugin"],
    "createdWithinDays": 7,
    "minStars": 10,
    "perTopic": 15
  },
  "cloudFeeds": {
    "$comment": "クラウドの changelog。新製品・一般提供（GA）だけを残す（機能追加・リージョン追加は落とす）",
    "enabled": true,
    "maxPerFeed": 8,
    "feeds": [
      { "label": "AWS", "url": "https://aws.amazon.com/about-aws/whats-new/recent/feed/" },
      { "label": "Google Cloud", "url": "https://cloud.google.com/feeds/gcp-release-notes.xml" },
      { "label": "Cloudflare", "url": "https://developers.cloudflare.com/changelog/rss/index.xml" },
      { "label": "Vercel", "url": "https://vercel.com/atom" }
    ]
  },
  "productHunt": {
    "enabled": true,
    "url": "https://www.producthunt.com/feed?category=developer-tools",
    "maxItems": 15
  }
}
