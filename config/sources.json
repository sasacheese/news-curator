{
  "$comment": "情報ソース定義。enabled: false にすると収集をスキップします。",
  "qiita": {
    "$comment": "作成日時の降順で返るため、ウィンドウ開始まで遡れる十分なページ数を確保する（1日あたり約400件）。",
    "enabled": true,
    "maxPages": 8,
    "perPage": 100
  },
  "zenn": {
    "enabled": true,
    "orders": ["daily", "latest"],
    "count": 100
  },
  "hatena": {
    "enabled": true,
    "feeds": [
      "https://b.hatena.ne.jp/hotentry/it.rss",
      "https://b.hatena.ne.jp/entrylist/it.rss"
    ]
  },
  "hackernews": {
    "enabled": true,
    "minPoints": 40,
    "hitsPerPage": 100
  },
  "devto": {
    "enabled": true,
    "perPage": 60,
    "minReactions": 15
  },
  "githubReleases": {
    "enabled": true,
    "$comment": "ウォッチするリポジトリ。前日7:00〜当日7:00に公開されたリリースだけを拾います。",
    "repos": [
      "facebook/react",
      "vercel/next.js",
      "microsoft/TypeScript",
      "nodejs/node",
      "vitejs/vite",
      "vitest-dev/vitest",
      "rolldown/rolldown",
      "oven-sh/bun",
      "denoland/deno",
      "prisma/prisma",
      "drizzle-team/drizzle-orm",
      "colinhacks/zod",
      "TanStack/query",
      "TanStack/router",
      "TanStack/table",
      "axios/axios",
      "vercel/swr",
      "microsoft/playwright",
      "tailwindlabs/tailwindcss",
      "biomejs/biome",
      "oxc-project/oxc",
      "honojs/hono",
      "trpc/trpc",
      "shadcn-ui/ui",
      "anthropics/claude-code",
      "anthropics/anthropic-sdk-typescript",
      "openai/codex",
      "modelcontextprotocol/servers",
      "cloudflare/workers-sdk",
      "storybookjs/storybook",
      "pnpm/pnpm",
      "eslint/eslint",
      "remix-run/react-router",
      "expressjs/express",
      "supabase/supabase"
    ],
    "includePrerelease": false
  },
  "githubTrending": {
    "enabled": true,
    "$comment": "直近に更新され、かつスター数の多いリポジトリを GitHub Search API で拾う簡易トレンド。",
    "minStars": 500,
    "perPage": 40,
    "queries": [
      "typescript OR javascript OR react OR nextjs",
      "ai agent OR llm OR mcp"
    ]
  },
  "rss": {
    "enabled": true,
    "feeds": [
      { "label": "Chrome Developers", "url": "https://developer.chrome.com/static/blog/feed.xml", "weight": 5 },
      { "label": "web.dev", "url": "https://web.dev/static/blog/feed.xml", "weight": 5 },
      { "label": "V8 Blog", "url": "https://v8.dev/blog.atom", "weight": 4 },
